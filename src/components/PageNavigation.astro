---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import LinkButton from "./LinkButton.astro";
import { BLOG_ROUTE_ROOT } from "@/data/siteNavigation";
import { getNavigationSegments, getPageAncestors } from "@/utils/navigation";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = { tagName?: string; article?: boolean };
const { tagName, article = false } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const segments =
  getNavigationSegments({
    pathname: Astro.url.pathname,
    basePath: import.meta.env.BASE_URL,
    locales: [locale],
  }) ?? [];
const ancestors = getPageAncestors(segments);
const parent = ancestors.at(-1) ?? ancestors[0];
const articleIndex = getRelativeLocaleUrl(locale, `${BLOG_ROUTE_ROOT}/`);
const toHref = (route: string) =>
  getRelativeLocaleUrl(locale, route ? `${route}/` : "");
---

<div
  class="app-layout text-muted-foreground mt-6 mb-3 text-sm"
  data-page-navigation
  data-navigation-tag={tagName}
>
  {
    article ? (
      <LinkButton
        id={config.features.showBackButton ? "back-button" : undefined}
        href={articleIndex}
        data-return-fallback={articleIndex}
        class="min-h-7 max-w-full"
      >
        <IconChevronLeft
          aria-hidden="true"
          class="size-4 shrink-0 rtl:rotate-180"
        />
        <span
          class="truncate"
          data-return-label
          data-i18n="navigation.postsDirectory"
        >
          {t.navigation.postsDirectory}
        </span>
      </LinkButton>
    ) : (
      <nav
        aria-label={t.a11y.breadcrumb}
        data-i18n-aria-label="a11y.breadcrumb"
      >
        <ol class="hidden min-h-7 items-center gap-x-2 sm:flex">
          {ancestors.map((item, index) => (
            <li class="flex items-center gap-x-2">
              {index > 0 && (
                <span aria-hidden="true" class="opacity-60">
                  /
                </span>
              )}
              <a
                href={toHref(item.route)}
                class="hover:text-accent underline-offset-4 hover:underline"
                data-i18n={`nav.${item.label}`}
              >
                {t.nav[item.label]}
              </a>
            </li>
          ))}
        </ol>
        <LinkButton
          href={toHref(parent.route)}
          class="min-h-7 max-w-full sm:hidden"
        >
          <IconChevronLeft
            aria-hidden="true"
            class="size-4 shrink-0 rtl:rotate-180"
          />
          <span class="truncate" data-i18n={`nav.${parent.label}`}>
            {t.nav[parent.label]}
          </span>
        </LinkButton>
      </nav>
    )
  }
</div>
