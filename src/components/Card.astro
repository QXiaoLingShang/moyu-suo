---
import type { CollectionEntry } from "astro:content";
import config from "@/config";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations } from "@/i18n";
import Datetime from "./Datetime.astro";
import Tag from "./Tag.astro";

type Props = {
  variant?: "h2" | "h3";
  transitionTitle?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  transitionTitle = true,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, tags, ...props } = data;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);
---

<li class="my-6">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent inline-block max-w-full text-lg font-medium wrap-anywhere",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    {
      transitionTitle ? (
        <Heading transition:name={toTransitionName(id)}>{title}</Heading>
      ) : (
        <Heading>{title}</Heading>
      )
    }
  </a>
  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
    <Datetime {...props} />
    {
      tags.length > 0 && (
        <ul
          class="flex flex-wrap items-center gap-x-3 gap-y-1.5"
          aria-label={t.post.tagLabel}
        >
          {tags.map(tag => (
            <Tag
              tag={slugifyStr(tag)}
              tagName={tag}
              size="sm"
              transition={false}
            />
          ))}
        </ul>
      )
    }
  </div>
  <p class="mt-2 leading-relaxed wrap-anywhere">{description}</p>
</li>
