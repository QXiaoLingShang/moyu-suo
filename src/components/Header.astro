---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHome from "@/assets/icons/IconHome.svg";
import IconFileText from "@/assets/icons/IconFileText.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import IconUser from "@/assets/icons/IconUser.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LangSwitcher from "./LangSwitcher.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import {
  BLOG_ROUTE_ROOTS,
  blogNavigation,
  globalNavigation,
  type NavigationItem,
} from "@/data/siteNavigation";
import config from "@/config";

type Props = {
  wide?: boolean;
};

const { wide = false } = Astro.props;
const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const menuLabels = {
  zh: useTranslations("zh-CN").a11y,
  en: useTranslations("en").a11y,
};

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const normalizedCurrentPath =
  currentPath === "/" ? "/" : currentPath.replace(/\/+$/, "");

function isPathWithin(route: string): boolean {
  if (!route) return normalizedCurrentPath === "/";
  const target = `/${route}`;
  return (
    normalizedCurrentPath === target ||
    normalizedCurrentPath.startsWith(`${target}/`)
  );
}

const isBlogSection = BLOG_ROUTE_ROOTS.some(isPathWithin);

function isActive(item: NavigationItem): boolean {
  return item.id === "blog" ? isBlogSection : isPathWithin(item.route);
}

function currentness(item: NavigationItem): "page" | "location" | undefined {
  if (!isActive(item)) return undefined;
  return normalizedCurrentPath === (item.route ? `/${item.route}` : "/")
    ? "page"
    : "location";
}

const navigationIcons = {
  home: IconHome,
  posts: IconFileText,
  about: IconUser,
  tags: IconHash,
  archives: IconArchive,
  search: IconSearch,
};

const visibleBlogNavigation = blogNavigation.filter(item =>
  item.id === "archives"
    ? features.showArchives
    : item.id === "search"
      ? features.search !== false
      : true
);

const navigationGroupLabels = t.navigationGroups;
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-[70] px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  transition:name="site-header"
  class:list={[
    "app-layout relative z-50 flex flex-col items-center justify-between sm:flex-row",
    { "site-header--wide": wide },
    { "site-header--compact": !wide },
  ]}
>
  <div
    class="border-border bg-background relative flex w-full items-baseline justify-between border-b py-4 sm:items-center sm:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
    >
      {site.title}
    </a>
    <nav
      id="nav-menu"
      class="relative z-50 flex w-full flex-col items-center sm:static sm:z-auto sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="site-nav__trigger focus-outline relative z-[60] self-end p-2"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
        data-label-open-zh={menuLabels.zh.openMenu}
        data-label-open-en={menuLabels.en.openMenu}
        data-label-close-zh={menuLabels.zh.closeMenu}
        data-label-close-en={menuLabels.en.closeMenu}
        data-i18n-aria-label="a11y.openMenu"
      >
        <span class="site-nav__mobile-icon" aria-hidden="true">
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </span>
      </button>
      <ul
        id="menu-items"
        class:list={[
          "site-nav__items border-border bg-background",
          "pointer-events-none fixed inset-x-0 top-[4.5rem] bottom-0 z-50 grid w-full grid-cols-6 content-start gap-x-2 gap-y-0 overflow-y-auto overscroll-contain px-8 pt-6 pb-24",
          "translate-y-2 opacity-0 transition-[opacity,transform] duration-250 motion-reduce:transition-none",
        ]}
      >
        <li
          class="site-nav__group site-nav__group--global col-span-6 mx-auto w-full max-w-72 sm:mx-0 sm:w-auto sm:max-w-none"
        >
          <div
            class="site-nav__group-content"
            role="group"
            aria-label={navigationGroupLabels.global}
            data-i18n-aria-label="navigationGroups.global"
          >
            <span
              class="site-nav__group-heading"
              aria-hidden="true"
              data-i18n="navigationGroups.global"
            >
              {navigationGroupLabels.global}
            </span>
            {
              globalNavigation.map(item => {
                const Icon = navigationIcons[item.icon];
                const active = isActive(item);
                const link = (
                  <a
                    href={getRelativeLocaleUrl(locale, item.route)}
                    class:list={["site-nav__link", { "active-nav": active }]}
                    data-nav-item
                    data-active={active ? "true" : undefined}
                    aria-current={currentness(item)}
                    aria-label={t.nav[item.label]}
                    data-i18n-aria-label={`nav.${item.label}`}
                  >
                    <Icon aria-hidden="true" class="size-5" />
                    <span data-i18n={`nav.${item.label}`}>
                      {t.nav[item.label]}
                    </span>
                  </a>
                );

                if (item.id !== "blog" || !isBlogSection) return link;

                return (
                  <div class="site-nav__global-entry">
                    {link}
                    <div class="site-nav__module-menu">
                      <button
                        type="button"
                        class="site-nav__module-trigger"
                        aria-label={t.a11y.switchBlogSection}
                        aria-expanded="false"
                        aria-controls="blog-sections-panel"
                        data-i18n-aria-label="a11y.switchBlogSection"
                      >
                        <svg
                          class="site-nav__chevron"
                          viewBox="0 0 12 12"
                          fill="none"
                        >
                          <path d="m2.25 4.5 3.75 3 3.75-3" />
                        </svg>
                      </button>
                      <ul
                        id="blog-sections-panel"
                        class="site-nav__module-panel border-border bg-background"
                        hidden
                      >
                        {visibleBlogNavigation.map(section => {
                          const sectionActive = isActive(section);
                          return (
                            <li>
                              <a
                                href={getRelativeLocaleUrl(
                                  locale,
                                  section.route
                                )}
                                class:list={[
                                  "site-nav__module-link",
                                  { "active-nav": sectionActive },
                                ]}
                                aria-current={currentness(section)}
                                aria-label={t.nav[section.label]}
                                data-i18n={`nav.${section.label}`}
                                data-i18n-aria-label={`nav.${section.label}`}
                              >
                                {t.nav[section.label]}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </li>
        {
          isBlogSection && (
            <li class="site-nav__group site-nav__group--local col-span-6 mx-auto w-full max-w-72 sm:mx-0 sm:w-auto sm:max-w-none">
              <div
                class="site-nav__group-content"
                role="group"
                aria-label={navigationGroupLabels.local}
                data-i18n-aria-label="navigationGroups.local"
              >
                <span
                  class="site-nav__group-heading"
                  aria-hidden="true"
                  data-i18n="navigationGroups.local"
                >
                  {navigationGroupLabels.local}
                </span>
                {visibleBlogNavigation.map(item => {
                  const Icon = navigationIcons[item.icon];
                  const active = isActive(item);
                  return (
                    <a
                      href={getRelativeLocaleUrl(locale, item.route)}
                      class:list={["site-nav__link", { "active-nav": active }]}
                      data-nav-item
                      data-active={active ? "true" : undefined}
                      aria-current={currentness(item)}
                      aria-label={t.nav[item.label]}
                      data-i18n-aria-label={`nav.${item.label}`}
                    >
                      <Icon aria-hidden="true" class="size-5" />
                      <span data-i18n={`nav.${item.label}`}>
                        {t.nav[item.label]}
                      </span>
                    </a>
                  );
                })}
              </div>
            </li>
          )
        }
        <li
          class="site-nav__group site-nav__group--utilities col-span-6 mx-auto mt-6 w-full max-w-72 sm:mx-0 sm:mt-0 sm:w-auto sm:max-w-none"
        >
          <div
            class="site-nav__group-content site-nav__group-content--utilities nav-utilities border-border flex w-full items-center justify-center gap-5 border-t pt-4 sm:w-auto sm:gap-2 sm:border-0 sm:pt-0"
            role="group"
            aria-label={navigationGroupLabels.utilities}
            data-i18n-aria-label="navigationGroups.utilities"
          >
            {
              features.lightAndDarkMode && (
                <button
                  id="theme-btn"
                  class="focus-outline hover:[&>svg]:stroke-accent relative size-10 p-3 sm:size-8 sm:p-2"
                  title={t.a11y.toggleTheme}
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              )
            }
            <LangSwitcher />
          </div>
        </li>
      </ul>
    </nav>
  </div>

  <style>
    #nav-menu {
      position: relative;
    }

    #menu-items {
      gap: 0;
    }

    .site-nav__trigger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--foreground);
    }

    .site-nav__mobile-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .site-nav__mobile-icon svg {
      width: 1.5rem;
      height: 1.5rem;
    }

    .site-nav__group {
      min-width: 0;
    }

    .site-nav__group-content {
      min-width: 0;
    }

    .site-nav__group-heading {
      display: none;
    }

    .site-nav__group-content > a,
    .site-nav__global-entry > a {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.75rem;
      padding-block: 0.75rem;
      border-bottom: 1px solid
        color-mix(in srgb, var(--foreground) 12%, transparent);
      color: var(--foreground);
      font-size: 0.9375rem;
      font-weight: 500;
      line-height: 1.5rem;
      text-align: start;
      transition:
        color 220ms cubic-bezier(0.22, 1, 0.36, 1),
        text-shadow 220ms ease;
    }

    .site-nav__global-entry {
      position: relative;
      min-width: 0;
    }

    .site-nav__module-menu {
      display: none;
    }

    .site-nav__group-content > a:not([data-active="true"]) {
      text-decoration: none;
    }

    .site-nav__group-content > a:last-of-type {
      border-bottom: 0;
    }

    .site-nav__group-content > a > span,
    .site-nav__global-entry > a > span {
      position: relative;
      z-index: 1;
    }

    .site-nav__group--local {
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid
        color-mix(in srgb, var(--foreground) 18%, transparent);
    }

    .site-nav__group-content > a[data-active="true"] {
      color: var(--accent);
    }

    .site-nav__group-content > a:hover,
    .site-nav__group-content > a:focus-visible,
    .site-nav__global-entry > a[data-active="true"],
    .site-nav__global-entry > a:hover,
    .site-nav__global-entry > a:focus-visible {
      color: var(--accent);
    }

    .site-nav__group-content > a svg {
      flex: 0 0 auto;
    }

    @media (max-width: 39.999rem) {
      .site-header--wide #menu-items {
        border-top: 1px solid
          color-mix(in srgb, var(--foreground) 12%, transparent);
        background: color-mix(in srgb, var(--background) 90%, transparent);
        box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 10%);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
      }
    }

    @media (min-width: 40rem) {
      #nav-menu {
        width: auto;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
      }

      .site-nav__group {
        width: auto;
        max-width: none;
        margin: 0;
        padding: 0;
        border: 0;
      }

      .site-nav__group-content {
        display: flex;
        width: auto;
        max-width: none;
        align-items: center;
        gap: 0.25rem;
      }

      .site-nav__group-content > a,
      .site-nav__global-entry > a {
        width: auto;
        min-height: 2rem;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.375rem 0.5rem;
        border: 0;
        border-radius: 0.25rem;
        font-size: 0.9375rem;
        line-height: 1.25rem;
        text-align: center;
      }

      #menu-btn {
        display: none;
      }

      #menu-items {
        position: static;
        display: flex;
        width: auto;
        max-height: none;
        grid-template-columns: none;
        align-items: center;
        gap: 0.75rem;
        overflow: visible;
        padding: 0;
        border: 0;
        background: transparent;
        box-shadow: none;
        opacity: 1;
        pointer-events: auto;
        transform: none;
        translate: none;
        transition: none;
        visibility: visible;
      }

      .site-nav__group--global .site-nav__group-content > a > svg,
      .site-nav__global-entry > a > svg {
        display: none;
      }

      .site-nav__group--local {
        display: none;
      }

      .site-nav__group-content--utilities {
        justify-content: center;
        gap: 0.25rem;
        margin-inline-start: 0.25rem;
        padding-inline-start: 0.5rem;
        border-inline-start: 1px solid
          color-mix(in srgb, var(--foreground) 24%, transparent);
      }

      .site-nav__group-content--utilities > :global([data-lang-switcher]) {
        margin-inline-start: 0.125rem;
      }

      .site-nav__chevron {
        width: 0.75rem;
        height: 0.75rem;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: transform 180ms ease;
      }

      .site-nav__global-entry {
        display: inline-flex;
        align-items: center;
      }

      .site-nav__module-menu {
        position: absolute;
        inset-block-start: 50%;
        inset-inline-start: calc(100% - 0.5rem);
        display: inline-flex;
        width: 1rem;
        height: 2rem;
        align-items: center;
        transform: translateY(-50%);
      }

      .site-nav__module-trigger {
        display: inline-flex;
        width: 1rem;
        height: 2rem;
        align-items: center;
        justify-content: flex-start;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--muted-foreground);
        cursor: pointer;
        transition: color 180ms ease;
      }

      .site-nav__module-trigger:hover,
      .site-nav__module-menu[data-open="true"] > .site-nav__module-trigger,
      .site-nav__module-trigger:focus-visible {
        color: var(--accent);
      }

      .site-nav__module-trigger:focus-visible {
        outline: 2px dashed var(--accent);
        outline-offset: 2px;
      }

      .site-nav__module-trigger .site-nav__chevron {
        width: 0.625rem;
        height: 0.625rem;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: transform 180ms ease;
      }

      .site-nav__module-menu[data-open="true"]
        > .site-nav__module-trigger
        .site-nav__chevron {
        transform: rotate(180deg);
      }

      .site-nav__module-panel {
        position: absolute;
        inset-block-start: calc(100% + 0.375rem);
        inset-inline-end: 0;
        z-index: 70;
        display: grid;
        min-width: 8rem;
        margin: 0;
        gap: 0;
        padding: 0.25rem;
        list-style: none;
        border: 1px solid color-mix(in srgb, var(--foreground) 13%, transparent);
        border-radius: 0.5rem;
        background: var(--background);
        box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 12%);
      }

      .site-nav__module-panel[hidden] {
        display: none;
      }

      .site-nav__module-link {
        display: flex;
        min-height: 2.25rem;
        align-items: center;
        padding: 0.5rem 0.625rem;
        border-radius: 0.375rem;
        color: var(--foreground);
        text-decoration: none;
        transition:
          color 160ms ease,
          background-color 160ms ease;
      }

      .site-nav__module-link:hover,
      .site-nav__module-link:focus-visible,
      .site-nav__module-link[aria-current="page"] {
        background: color-mix(in srgb, var(--accent) 8%, transparent);
        color: var(--accent);
      }
    }

    /* Keep generated navigation usable if the client controller never starts. */
    #nav-menu:not([data-enhanced]) #menu-btn {
      display: none;
    }

    #nav-menu:not([data-enhanced]) #menu-items {
      position: static;
      display: grid;
      width: 100%;
      max-height: none;
      grid-template-columns: 1fr;
      overflow: visible;
      padding: 1rem 2rem;
      border: 0;
      background: transparent;
      opacity: 1;
      pointer-events: auto;
      transform: none;
      translate: none;
      transition: none;
      visibility: visible;
    }

    #nav-menu:not([data-enhanced]) .site-nav__module-menu {
      display: none;
    }

    #nav-menu:not([data-enhanced]) .site-nav__group--local {
      display: block;
    }

    @media (min-width: 40rem) {
      #nav-menu:not([data-enhanced]) #menu-items {
        display: flex;
        width: auto;
        grid-template-columns: none;
        overflow: visible;
        padding: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .site-nav__module-trigger,
      .site-nav__module-trigger .site-nav__chevron,
      .site-nav__module-link {
        transition: none;
      }
    }
  </style>

  <script>
    import { setupSiteHeader } from "@/scripts/siteHeader";

    setupSiteHeader();
  </script>
</header>
