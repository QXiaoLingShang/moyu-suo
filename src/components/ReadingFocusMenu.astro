---
import config from "@/config";
import { useTranslations } from "@/i18n";

const locale = Astro.currentLocale ?? config.site.lang;
const { readingFocus: labels } = useTranslations(locale);
---

<div class="reading-focus-toolbar" data-pagefind-ignore hidden>
  <details id="reading-focus-menu" class="reading-focus-menu">
    <summary class="reading-focus-summary">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"
        ></path>
        <path d="M7 12h10"></path>
      </svg>
      <span data-i18n="readingFocus.title">{labels.title}</span>
    </summary>

    <div class="reading-focus-panel">
      <div class="reading-focus-panel-heading" data-i18n="readingFocus.title">
        {labels.title}
      </div>

      <label class="reading-focus-switch-row">
        <span data-i18n="readingFocus.pointer">{labels.pointer}</span>
        <input
          type="checkbox"
          data-reading-focus-toggle
          aria-describedby="reading-focus-pointer-hint"
        />
        <span class="reading-focus-switch" aria-hidden="true"></span>
      </label>

      <p
        id="reading-focus-pointer-hint"
        class="reading-focus-pointer-hint"
        data-i18n="readingFocus.hint"
      >
        {labels.hint}
      </p>

      <fieldset class="reading-focus-styles">
        <legend data-i18n="readingFocus.style">{labels.style}</legend>
        <div class="reading-focus-style-options">
          {
            (["left", "right", "block"] as const).map(style => (
              <label>
                <input
                  type="radio"
                  name="reading-focus-style"
                  value={style}
                  data-reading-focus-style
                />
                <span class={`reading-focus-style-preview is-${style}`}>
                  <span class="reading-focus-style-swatch" aria-hidden="true" />
                  <span data-i18n={`readingFocus.${style}`}>
                    {labels[style]}
                  </span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="reading-focus-switch-row">
        <span data-i18n="readingFocus.toc">{labels.toc}</span>
        <input type="checkbox" data-reading-focus-toc-toggle />
        <span class="reading-focus-switch" aria-hidden="true"></span>
      </label>

      <label class="reading-focus-range" for="reading-focus-duration">
        <span data-i18n="readingFocus.duration">{labels.duration}</span>
        <span>
          <output for="reading-focus-duration" data-reading-focus-duration-value
            >4</output
          >
          <span data-i18n="readingFocus.seconds">{labels.seconds}</span>
        </span>
        <input
          id="reading-focus-duration"
          type="range"
          min="2"
          max="8"
          step="1"
          value="4"
        />
      </label>
      <label class="reading-focus-range" for="reading-focus-offset">
        <span data-i18n="readingFocus.offset">{labels.offset}</span>
        <span>
          <output for="reading-focus-offset" data-reading-focus-offset-value
            >22</output
          >%
        </span>
        <input
          id="reading-focus-offset"
          type="range"
          min="10"
          max="40"
          step="1"
          value="22"
        />
      </label>
    </div>
  </details>
</div>
