---
import IconWorld from "@/assets/icons/IconWorld.svg";

const locale = Astro.currentLocale ?? "zh-CN";
const initialLanguage = locale.startsWith("en") ? "en" : "zh-CN";
---

<div class="lang-switcher" data-lang-switcher>
  <button
    type="button"
    class="lang-switcher__trigger focus-outline hover:text-accent"
    aria-label="显示语言 / Display language"
    title="显示语言 / Display language"
    aria-expanded="false"
    aria-controls="language-options"
    data-lang-toggle
  >
    <IconWorld aria-hidden="true" class="size-6 shrink-0" />
    <span data-lang-current aria-hidden="true">
      {initialLanguage === "en" ? "EN" : "中"}
    </span>
    <svg
      aria-hidden="true"
      class="lang-switcher__chevron"
      viewBox="0 0 12 12"
      fill="none"
    >
      <path d="m2.25 4.5 3.75 3 3.75-3"></path>
    </svg>
  </button>
  <div
    id="language-options"
    class="lang-switcher__menu"
    role="group"
    aria-label="选择界面语言 / Choose interface language"
    data-lang-menu
    hidden
  >
    <button
      type="button"
      data-lang-option="zh-CN"
      data-selected={initialLanguage === "zh-CN"}
      aria-pressed={initialLanguage === "zh-CN"}
      lang="zh-CN"
      aria-label="简体中文"
    >
      简体中文
    </button>
    <button
      type="button"
      data-lang-option="en"
      data-selected={initialLanguage === "en"}
      aria-pressed={initialLanguage === "en"}
      lang="en"
      aria-label="English"
    >
      English
    </button>
  </div>
</div>

<script>
  import { setupLangSwitcher } from "@/i18n/client";

  setupLangSwitcher();
  document.addEventListener("astro:after-swap", setupLangSwitcher);
</script>

<style>
  .lang-switcher {
    position: relative;
    color: var(--foreground);
  }

  .lang-switcher__trigger {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    border-radius: 0.25rem;
    cursor: pointer;
    transition: color 180ms ease;
  }

  .lang-switcher__chevron {
    width: 0.75rem;
    height: 0.75rem;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }

  .lang-switcher[data-open="true"] .lang-switcher__chevron {
    transform: rotate(180deg);
  }

  .lang-switcher[data-open="true"] .lang-switcher__menu {
    animation: lang-switcher-enter 150ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .lang-switcher__menu {
    position: absolute;
    z-index: 80;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    display: grid;
    min-width: 9.5rem;
    gap: 0.125rem;
    padding: 0.375rem;
    border: 1px solid color-mix(in srgb, var(--foreground) 18%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--background) 92%, transparent);
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 18%);
    backdrop-filter: blur(1rem);
    -webkit-backdrop-filter: blur(1rem);
    transform-origin: top right;
  }

  .lang-switcher__menu[hidden] {
    display: none;
  }

  .lang-switcher__menu button {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .lang-switcher__menu button:hover,
  .lang-switcher__menu button:focus-visible {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .lang-switcher__menu button[data-selected="true"]::after {
    color: var(--accent);
    content: "✓";
  }

  @keyframes lang-switcher-enter {
    from {
      transform: translateY(-0.25rem) scale(0.98);
      opacity: 0;
    }

    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switcher__trigger,
    .lang-switcher__chevron,
    .lang-switcher__menu button {
      transition: none;
    }

    .lang-switcher[data-open="true"] .lang-switcher__menu {
      animation: none;
    }
  }
</style>
