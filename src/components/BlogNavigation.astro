---
import { getRelativeLocaleUrl } from "astro:i18n";
import { blogNavigation } from "@/data/siteNavigation";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const items = blogNavigation.filter(item =>
  item.id === "archives"
    ? config.features.showArchives
    : item.id === "search"
      ? config.features.search !== false
      : true
);
---

<nav
  class="mt-3"
  aria-label={t.navigationGroups.local}
  data-i18n-aria-label="navigationGroups.local"
>
  <ul class="text-muted-foreground flex flex-wrap gap-x-5 gap-y-2 text-sm">
    {
      items.map(item => (
        <li>
          <a
            href={getRelativeLocaleUrl(locale, `${item.route}/`)}
            class="hover:text-accent underline-offset-4 hover:underline"
            data-i18n={`nav.${item.label}`}
          >
            {t.nav[item.label]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
