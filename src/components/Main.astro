---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  pageTitleKey?: string;
  pageDescKey?: string;
  phraseTitle?: boolean;
  phraseDesc?: boolean;
  transitionName?: string;
  class?: string;
};

const {
  pageTitle,
  pageDesc,
  pageTitleKey,
  pageDescKey,
  phraseTitle,
  phraseDesc,
  transitionName,
  class: className,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <h1
    transition:name={transitionName}
    class="text-2xl font-semibold sm:text-3xl"
    data-i18n={pageTitleKey || undefined}
    data-i18n-phrase={phraseTitle || undefined}
  >
    {pageTitle}
  </h1>
  <p
    class="mt-2 mb-6 italic"
    data-i18n={pageDescKey || undefined}
    data-i18n-phrase={phraseDesc || undefined}
  >
    {pageDesc}
  </p>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
