---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { formatDate } from "@/utils/formatDate";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  /** 文章由 AI 生成/协助：在日期后追加极简 AI 徽标 */
  aiGenerated?: boolean;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  aiGenerated = false,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const effectiveDate = modDatetime
  ? new Date(modDatetime)
  : new Date(pubDatetime);
const pubDate = new Date(pubDatetime);
const isModified = !Number.isNaN(effectiveDate.getTime()) &&
  !Number.isNaN(pubDate.getTime()) &&
  effectiveDate.getTime() > pubDate.getTime();

// 用真实时间 + IANA 时区渲染日期；语言走 Astro i18n 当前 locale
// （data-i18n-date 供客户端切换语言时按同一规则重算）
const tz = postTimezone ?? config.site.timezone;
const lang = (Astro.currentLocale ?? config.site.lang) === "en" ? "en" : "zh-CN";
const dateText = formatDate(effectiveDate, tz, lang);
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        <span data-i18n="post.updatedAt">{t.post.updatedAt}</span>:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={effectiveDate.toISOString()}
    data-i18n-date
    data-tz={tz}
  >
    {dateText}
  </time>
  {
    aiGenerated && (
      <span
        class="bg-accent/10 text-accent rounded-full px-2 py-0.5 text-xs font-semibold"
        title={t.post.aiBadge}
        data-i18n-title="post.aiBadge"
      >
        AI
      </span>
    )
  }
</div>
