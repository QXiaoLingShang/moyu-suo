---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  transition?: boolean;
};

const { tag, tagName, size = "lg", transition = true } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `tags/${tag}/`);
const linkClasses = [
  "flex items-center gap-0.5",
  "border-foreground border-b-2 border-dashed",
  "hover:border-accent hover:text-accent hover:-mt-0.5",
  "focus-visible:text-accent focus-visible:border-none",
  { "text-sm": size === "sm", "text-lg": size === "lg" },
];
const iconClasses = [
  "opacity-80",
  { "size-5": size === "lg", "size-4": size === "sm" },
];
---

<li>
  {
    // An undefined transition:name generates an Astro name; omit the directive.
    transition ? (
      <a href={href} transition:name={tag} class:list={linkClasses}>
        <IconHash aria-hidden="true" class:list={iconClasses} />
        {tagName}
      </a>
    ) : (
      <a href={href} class:list={linkClasses}>
        <IconHash aria-hidden="true" class:list={iconClasses} />
        {tagName}
      </a>
    )
  }
</li>
