---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import {
  BLOG_ROUTE_ROOT,
  blogNavigation,
  globalNavigation,
} from "@/data/siteNavigation";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = { tagName?: string };
const { tagName } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const segments = stripLocale(stripBase(Astro.url.pathname), locale)
  .split("/")
  .filter(Boolean);
const [root, detail, page] = segments;
const section = [...globalNavigation, ...blogNavigation].find(
  item => item.route === root
);

type Item = { label: string; key?: string; route: string; page?: string };
const breadcrumbs: Item[] = [{ label: t.nav.home, key: "nav.home", route: "" }];
// Content hierarchy is independent of the flat public URL paths.
if (blogNavigation.some(item => item.route === root)) {
  breadcrumbs.push({
    label: t.nav.posts,
    key: "nav.posts",
    route: BLOG_ROUTE_ROOT,
  });
}
if (section) {
  breadcrumbs.push({
    label: t.nav[section.label],
    key: `nav.${section.label}`,
    route: section.route,
    page:
      root === BLOG_ROUTE_ROOT && detail && detail !== "1" ? detail : undefined,
  });
}
if (root === "tags" && detail) {
  let label = tagName ?? detail;
  if (!tagName) {
    try {
      label = decodeURIComponent(detail);
    } catch {
      /* Keep a malformed segment readable. */
    }
  }
  breadcrumbs.push({
    label,
    route: `tags/${detail}`,
    page: page && page !== "1" ? page : undefined,
  });
}
---

<nav
  class="app-layout mt-8 mb-1"
  aria-label={t.a11y.breadcrumb}
  data-i18n-aria-label="a11y.breadcrumb"
>
  <ol
    class="text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
  >
    {
      breadcrumbs.map((item, index) => (
        <li class="flex items-center gap-x-2">
          {index > 0 && (
            <span aria-hidden="true" class="opacity-60">
              /
            </span>
          )}
          {index < breadcrumbs.length - 1 ? (
            <a
              href={getRelativeLocaleUrl(
                locale,
                item.route ? `${item.route}/` : ""
              )}
              class="hover:text-accent underline-offset-4 hover:underline"
              data-i18n={item.key}
            >
              {item.label}
            </a>
          ) : (
            <span aria-current="page">
              <span data-i18n={item.key}>{item.label}</span>
              {item.page && (
                <>
                  {" "}
                  · <span data-i18n="pagination.page">
                    {t.pagination.page}
                  </span>{" "}
                  {item.page}
                </>
              )}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
