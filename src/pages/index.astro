---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/home.css";

const locale = Astro.currentLocale ?? config.site.lang;
const isChinese = locale.startsWith("zh");
const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
).slice(0, config.posts.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");
const postsPath = getRelativeLocaleUrl(locale, "posts");

// The three future destinations remain in the composition without pretending
// that an empty collection is a usable page.
const entrances = [
  {
    key: "posts",
    title: isChinese ? "文章" : "Posts",
    description: isChinese ? "写下此刻的想法" : "Thoughts in writing",
    href: postsPath,
  },
  {
    key: "projects",
    title: isChinese ? "项目" : "Projects",
    description: isChinese ? "一些有趣的尝试" : "Interesting attempts",
  },
  {
    key: "about",
    title: isChinese ? "关于" : "About",
    description: isChinese ? "认识这里的我" : "Get to know me",
    href: getRelativeLocaleUrl(locale, "about"),
  },
  {
    key: "gallery",
    title: isChinese ? "相册" : "Gallery",
    description: isChinese ? "收集生活的片段" : "Pieces of life",
  },
  {
    key: "archives",
    title: isChinese ? "归档" : "Archives",
    description: isChinese ? "按时间翻阅" : "Browse by time",
    href: config.features.showArchives
      ? getRelativeLocaleUrl(locale, "archives")
      : undefined,
  },
  {
    key: "friends",
    title: isChinese ? "友链" : "Friends",
    description: isChinese ? "遇见有趣的人" : "Interesting people",
  },
];

const dateFormatter = new Intl.DateTimeFormat(isChinese ? "zh-CN" : "en-US", {
  month: "short",
  day: "numeric",
  timeZone: config.site.timezone,
});
---

<Layout>
  <Header wide />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="home-page"
  >
    <section class="home-stage" aria-labelledby="home-title">
      <img
        class="home-stage__art"
        src={getAssetPath("assets/home/corner-accents.webp")}
        alt=""
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
      />
      <div class="home-orbit home-orbit--outer" aria-hidden="true"></div>
      <div class="home-orbit home-orbit--inner" aria-hidden="true"></div>

      <div class="home-disc">
        <img
          class="home-disc__image"
          src={getAssetPath("assets/home/portal-art.webp")}
          alt=""
          width="960"
          height="960"
          loading="eager"
          decoding="async"
        />
        <div class="home-disc__content">
          <h1 id="home-title">{config.site.title}</h1>
          <span class="home-disc__rule" aria-hidden="true"></span>
          <p>
            {
              isChinese
                ? "在文字的涟漪里，打捞一些晴天"
                : "Finding bright days in words"
            }
          </p>
        </div>
      </div>

      <nav
        class="home-entrances"
        aria-label={isChinese ? "探索本站" : "Explore the site"}
      >
        <ul>
          {
            entrances.map(entry => (
              <li
                class:list={[
                  "home-entrance",
                  `home-entrance--${entry.key}`,
                  { "home-entrance--waiting": !entry.href },
                ]}
              >
                {entry.href ? (
                  <a href={entry.href} class="home-entrance__content">
                    <span
                      class="home-entrance__title"
                      transition:name={
                        entry.key === "posts" ? "home-posts-heading" : undefined
                      }
                    >
                      {entry.title}
                    </span>
                    <span class="home-entrance__description">
                      {entry.description}
                    </span>
                  </a>
                ) : (
                  <span
                    class="home-entrance__content"
                    aria-label={`${entry.title}，${isChinese ? "尚未开放" : "coming soon"}`}
                    title={isChinese ? "尚未开放" : "Coming soon"}
                  >
                    <span class="home-entrance__title">{entry.title}</span>
                    <span class="home-entrance__description">
                      {entry.description}
                    </span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="home-stage__continue" href="#home-recent">
        <span>{isChinese ? "向下继续" : "Continue below"}</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path
            d="m4 8 8 8 8-8"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </section>

    <section
      id="home-recent"
      class="home-recent"
      aria-labelledby="home-recent-title"
    >
      <div class="home-recent__heading">
        <h2 id="home-recent-title">
          {isChinese ? "最近写的" : "Recently written"}
        </h2>
        <a href={postsPath}>
          <span>{isChinese ? "查看更多" : "View all"}</span>
          <IconArrowRight aria-hidden="true" />
        </a>
      </div>
      <ul class="home-recent__list">
        {
          posts.map(({ id, filePath, data }) => (
            <li>
              <time datetime={data.pubDatetime.toISOString()}>
                {dateFormatter.format(data.pubDatetime)}
              </time>
              <a href={getPostUrl(id, filePath, locale)}>{data.title}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <Footer class="home-footer" />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const home = document.querySelector<HTMLElement>(
      "#main-content[data-layout='index']"
    );
    if (home) {
      sessionStorage.setItem(
        "backUrl",
        home.dataset.homePath ?? import.meta.env.BASE_URL
      );
    }
  });
</script>
